{
    "name": "GenAI Jupyter Notebooks with MongoDB",
    "dockerComposeFile": "docker-compose.yml",
    "service": "notebooks",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "forwardPorts": [
        8888,
        27017
    ],
    "containerEnv": {
        "PROXY_ENDPOINT": "https://vtqjvgchmwcjwsrela2oyhlegu0hwqnw.lambda-url.us-west-2.on.aws/",
        "MONGODB_URI": "mongodb://admin:mongodb@mongodb:27017/",
        "HF_HOME": "/tmp/huggingface"
    },

	"updateContentCommand": "bash .devcontainer/setup.sh && bash .devcontainer/install-mongodb-db-tools.sh",
    "postCreateCommand": "bash .devcontainer/track.sh created || true",
    "postStartCommand": "jupyter notebook python/*.ipynb --allow-root && bash .devcontainer/track.sh started || true'",
    "customizations": {
        "codespaces": {
            "openFiles": []
        },
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "mongodb.mongodb-vscode"
            ]
        }
    }
}